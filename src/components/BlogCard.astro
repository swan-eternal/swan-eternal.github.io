---
/**
 * A blog post row for the "Writing" list.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;

const slug = post.id.replace(/\.md$/, '');

// "2026-11-08" -> "8 Nov 2026"
const formatted = data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post">
  <a href={`/blog/${slug}/`}>
    <div class="head">
      <h3 class="title">{data.title}</h3>
      <time class="date" datetime={data.pubDate.toISOString()}>
        {formatted}
      </time>
    </div>
    <p class="pitch">{data.description}</p>
    {
      data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </a>
</article>

<style>
  .post {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  .post:last-child {
    border-bottom: 0;
  }

  .post a {
    color: inherit;
    text-decoration: none;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .title {
    margin: 0;
    font-size: 1.0625rem;
  }

  .date {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .pitch {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .post a:hover .title {
    color: var(--accent);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.55rem 0 0;
    padding: 0;
  }

  .tags li {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }
</style>
