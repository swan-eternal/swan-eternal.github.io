---
/**
 * Homepage.
 *
 * Two separate grids, not one mixed list — borrowed straight from ncase.me,
 * which splits "SHTUFF YOU CAN PLAY" from "SHTUFF YOU CAN READ". The split
 * is doing real work here: a visitor can tell within one glance whether
 * this site has things to click or things to read.
 *
 * Sections:
 *   1. "Digital"  -> games, interactive apps/vizzes, software
 *   2. "Physical" -> physical projects (machined parts, rigs, gear)
 *   3. "Writing"  -> recent blog posts
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';

const projects = await getCollection('projects');
const posts = await getCollection('blog', ({ data }) => !data.draft);

// --- Section 1: digital ---------------------------------------------------
const digital = projects
  .filter((p) => ['game', 'interactive', 'software'].includes(p.data.kind))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// --- Section 2: physical --------------------------------------------------
const physical = projects
  .filter((p) => p.data.kind === 'physical')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// --- Section 3: reading ---------------------------------------------------
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="Home"
  description="Swanware — engineer, game developer, and tinkerer. Projects, writing, and interactive experiments."
>
  <h1>Swanware</h1>

  {
    digital.length > 0 && (
      <>
        <h2 class="section-title">Digital</h2>
        <div class="grid">
          {digital.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </>
    )
  }

  {
    physical.length > 0 && (
      <>
        <h2 class="section-title">Physical</h2>
        <div class="grid">
          {physical.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </>
    )
  }

  {
    recentPosts.length > 0 && (
      <>
        <h2 class="section-title">Writing</h2>
        <div class="posts">
          {recentPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
        <p class="page-nav">
          <a href="/blog">All writing &rarr;</a>
        </p>
      </>
    )
  }

  <p class="page-nav">
    <a href="/projects">All projects &rarr;</a>
  </p>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
  }
</style>
