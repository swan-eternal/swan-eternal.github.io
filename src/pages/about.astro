---
/**
 * About page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Who Swanware is and what this site is for."
>
  <h1>About</h1>

  <p class="lede">Games, tools, and the occasional hardware tangent — built under the name Swanware.</p>

  <h2>What this site is</h2>
  <p>
    Three things live here: projects I want to show off properly, writing when
    I have something worth saying, and small interactive experiments that
    only make sense if you can poke at them.
  </p>

  <h2>Contact</h2>
  <ul>
    <li><a href="https://github.com/swan-eternal">GitHub</a></li>
    <li><a href="https://swanware.itch.io">itch.io</a></li>
  </ul>

  <h2>Colophon</h2>
  <p>
    Built with <a href="https://astro.build/">Astro</a> and hosted on GitHub
    Pages. No trackers, no cookie banner, no analytics.
  </p>
</BaseLayout>
